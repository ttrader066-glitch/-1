# Allegro Developer Portal: https://apps.developer.allegro.pl
ALLEGRO_CLIENT_ID=your_client_id_here
ALLEGRO_CLIENT_SECRET=your_client_secret_here
ALLEGRO_REDIRECT_URI=http://localhost

# true = sandbox (allegrosandbox.pl), false = produkcja
USE_SANDBOX=false

# Co ile minut bot sprawdza oferty
SCHEDULE_INTERVAL_MINUTES=30

# Ile ofert przetwarzać na jeden przebieg
MAX_OFFERS_PER_RUN=50

# Minimalna pewność dopasowania pojazdu (0.0 - 1.0)
MIN_MATCH_CONFIDENCE=0.7
